# https://ghostty.org/docs/config/reference
keybind = global:alt+space=toggle_quick_terminal
quick-terminal-position=center
quick-terminal-animation-duration=0
quick-terminal-size=90%,90%
quick-terminal-screen=macos-menu-bar
quick-terminal-autohide=false
theme = TokyoNight
custom-shader = ~/ghq/github.com/masaki39/dotfiles/ghostty/shader/cursor-trail.glsl
macos-option-as-alt = true
macos-titlebar-style=tabs
background-opacity=0.9
maximize = true
unfocused-split-opacity = 0.5
# unfocused-split-fill = #a9b1d6
split-divider-color = #7aa2f7
# confirm-close-surface=false
keybind = alt+right=unbind
keybind = alt+left=unbind
keybind = super+alt+w=close_tab:other
keybind = super+shift+w=close_tab
keybind = super+alt+right=next_tab
keybind = super+alt+left=previous_tab
keybind = super+alt+l=next_tab
keybind = super+alt+h=previous_tab
keybind = super+ctrl+down=goto_split:down
keybind = super+ctrl+left=goto_split:left
keybind = super+ctrl+right=goto_split:right
keybind = super+ctrl+up=goto_split:up
keybind = super+ctrl+j=goto_split:down
keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+l=goto_split:right
keybind = super+ctrl+k=goto_split:up
keybind = super+ctrl+shift+down=resize_split:down,10
keybind = super+ctrl+shift+left=resize_split:left,10
keybind = super+ctrl+shift+right=resize_split:right,10
keybind = super+ctrl+shift+up=resize_split:up,10
keybind = super+ctrl+shift+j=resize_split:down,10
keybind = super+ctrl+shift+h=resize_split:left,10
keybind = super+ctrl+shift+l=resize_split:right,10
keybind = super+ctrl+shift+k=resize_split:up,10
keybind = super+ctrl+f=toggle_split_zoom
