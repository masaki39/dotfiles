{
  "$schema": "https://tadashi-aikawa.github.io/jinrai/schemas/config.schema.json",
  // Jinrai config (JSONC: comments and trailing commas allowed)
  // Each feature is enabled only when its section exists
  // Highlight the window with a border when focus moves
  "focusBorder": {},
  // option+shift+cmd+ctrl+tab returns to the previous window
  "focusBack": {
    "hotkey": {
      "modifiers": [
        "option",
        "shift",
        "cmd",
        "ctrl"
      ],
      "key": "tab"
    }
  },
  // Window hints (option+shift+cmd+ctrl+j)
  "windowHints": {
    "hotkey": {
      "modifiers": [
        "option",
        "shift",
        "cmd",
        "ctrl"
      ],
      "key": "j"
    },
    "hint": {
      "prefixOverrides": [
        {
          "match": {
            "bundleID": "com.apple.systempreferences"
          },
          "prefix": "S"
        },
        {
          "match": {
            "bundleID": "com.apple.Preview"
          },
          "prefix": "P"
        },
        {
          "match": {
            "bundleID": "com.google.Chrome"
          },
          "prefix": "B"
        },
        {
          "match": {
            "bundleID": "com.microsoft.Word"
          },
          "prefix": "W"
        },
        {
          "match": {
            "bundleID": "com.microsoft.Excel"
          },
          "prefix": "E"
        },
        {
          "match": {
            "bundleID": "com.microsoft.Powerpoint"
          },
          "prefix": "P"
        },
      ]
    },
    "navigation": {
      "focusBack": {
        "key": "tab"
      },
      "direction": {
        "hints": {
          "keys": {
            "left": "h",
            "down": "j",
            "up": "k",
            "right": "l"
          }
        }
      },
      "areaHints": {
        "key": "space"
      },
      "applicationHints": {
        "key": "n",
        "jinraiMode": true
      }
    }
  },
  // Window movement
  "windowMover": {
    "commands": {
      "moveToNextDisplay": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "space"
        }
      },
      "moveToActiveDisplayFreeArea": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "tab"
        }
      },
      "maximizeWindow": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "return"
        }
      },
      // Corners: y u / n m (same letters as Area Hints)
      "quarterTopLeft": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "y"
        }
      },
      "quarterTopRight": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "u"
        }
      },
      "quarterBottomLeft": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "n"
        }
      },
      "quarterBottomRight": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "m"
        }
      },
      "cycleLeft": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "h"
        }
      },
      "cycleRight": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "l"
        }
      }
    },
    "behavior": {
      "cursor": {
        "afterMove": true
      },
      "freeArea": {
        "excludeHiddenWindows": false
      }
    },
  },
  "displayAliases": {
    "macbook": "37D8832A-2D66-02CA-B9F7-8F30A301B230",
    "desk": "A5F30F68-1D7E-41AE-97C8-2ACAE66D0AFF"
  },
  "areaHints": {
    // Key scheme: [display][size][position]
    //   display:  none = main, s = sub (MacBook while two displays are connected)
    //   size:     none = 1/2, 3 = 1/3, 4 = 1/4, 6 = 1/6, e = 2/3, r = 3/4
    //   position: h l = left right, k j = top bottom (sixth tiles), y u n m = corners (all right index finger),
    //             i = horizontal center, c = fixed-size center
    // Full-width rows and centered areas are left out: their labels share the center
    // column and stack past the screen height.
    // Used for the external display and any unregistered display
    "defaultScreen": {
      // Whole / free / fixed size
      "full": "a",
      "freeArea": "f",
      "1600x1000Center": "c",
      // Halves: h l = edges, i = horizontal center
      "halfLeft": "h",
      "halfRight": "l",
      "halfHorizontalCenter": "i",
      // Corners (1/2 x 1/2): y u / n m
      "quarterTopLeft": "y",
      "quarterTopRight": "u",
      "quarterBottomLeft": "n",
      "quarterBottomRight": "m",
      // Thirds (3)
      "thirdLeft": "3h",
      "thirdHorizontalCenter": "3i",
      "thirdRight": "3l",
      // Quarter columns (4): uppercase = one step inward
      "quarterLeft": "4h",
      "quarterHorizontalLeftCenter": "4H",
      "quarterHorizontalRightCenter": "4L",
      "quarterRight": "4l",
      // Sixths (6): h/l = narrow columns, y k u / n j m = tiles
      "sixthLeft": "6h",
      "sixthRight": "6l",
      "sixthTopLeft": "6y",
      "sixthTopCenter": "6k",
      "sixthTopRight": "6u",
      "sixthBottomLeft": "6n",
      "sixthBottomCenter": "6j",
      "sixthBottomRight": "6m",
      // Two thirds (e = key below 3)
      "twoThirdsLeft": "eh",
      "twoThirdsHorizontalCenter": "ei",
      "twoThirdsRight": "el",
      // Three quarters (r = key below 4)
      "threeQuartersLeft": "rh",
      "threeQuartersHorizontalCenter": "ri",
      "threeQuartersRight": "rl",
    },
    "screens": {
      "macbook": {
        // Two displays: same keys with the "s" prefix (alone it falls back to defaultScreen)
        "2": {
          // Whole / free / fixed size
          "full": "sa",
          "freeArea": "sf",
          "1600x1000Center": "sc",
          // Halves: h l = edges, i = horizontal center
          "halfLeft": "sh",
          "halfRight": "sl",
          "halfHorizontalCenter": "si",
          // Corners (1/2 x 1/2): y u / n m
          "quarterTopLeft": "sy",
          "quarterTopRight": "su",
          "quarterBottomLeft": "sn",
          "quarterBottomRight": "sm",
          // Thirds (3)
          "thirdLeft": "s3h",
          "thirdHorizontalCenter": "s3i",
          "thirdRight": "s3l",
          // Quarter columns (4): uppercase = one step inward
          "quarterLeft": "s4h",
          "quarterHorizontalLeftCenter": "s4H",
          "quarterHorizontalRightCenter": "s4L",
          "quarterRight": "s4l",
          // Sixths (6): h/l = narrow columns, y k u / n j m = tiles
          "sixthLeft": "s6h",
          "sixthRight": "s6l",
          "sixthTopLeft": "s6y",
          "sixthTopCenter": "s6k",
          "sixthTopRight": "s6u",
          "sixthBottomLeft": "s6n",
          "sixthBottomCenter": "s6j",
          "sixthBottomRight": "s6m",
          // Two thirds (e = key below 3)
          "twoThirdsLeft": "seh",
          "twoThirdsHorizontalCenter": "sei",
          "twoThirdsRight": "sel",
          // Three quarters (r = key below 4)
          "threeQuartersLeft": "srh",
          "threeQuartersHorizontalCenter": "sri",
          "threeQuartersRight": "srl",
        },
      },
    },
    // Press before an area key to move without resizing
    "keepSize": {
      "key": "g"
    },
    "actions": {
      "closeWindow": "x",
      "detachChromeTabToNewWindow": "t"
    },
    "navigation": {
      "windowHints": {
        "key": "space"
      }
    },
  },
  // Jinrai mode
  "jinraiMode": {
    "triggers": {
      "windowHints": {
        "key": "m"
      }
    },
    "combo": {
      "character": {
        // Show a character image based on the action count.
        "enabled": true
      },
      "text": {
        // Show the streak count as COMBO text.
        "enabled": true
      }
    }
  },
  // App launcher (opened with "n" from Window Hints)
  "applicationHints": {
    "apps": [
      {
        "bundleID": "com.mitchellh.ghostty",
        "key": "G"
      },
      {
        "bundleID": "com.google.Chrome",
        "key": "B"
      }
    ]
  },
  // Only the maximize-all layout, bound directly (no picker menu)
  "windowLayouts": {
    "layouts": [
      {
        "name": "maximizeAll",
        "hotkey": {
          "modifiers": [
            "ctrl",
            "alt"
          ],
          "key": "a"
        },
        "unlistedWindows": {
          "area": "full"
        }
      }
    ],
  },
}
