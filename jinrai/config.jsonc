{
  "$schema": "https://tadashi-aikawa.github.io/jinrai/schemas/config.schema.json",
  // Jinrai config (JSONC: comments and trailing commas allowed)
  // Each feature is enabled only when its section exists
  // Highlight the window with a border when focus moves
  "focusBorder": {},
  // option+shift+cmd+ctrl+tab returns to the previous window
  "focusBack": {
    "hotkey": {
      "modifiers": [
        "option",
        "shift",
        "cmd",
        "ctrl"
      ],
      "key": "tab"
    }
  },
  // Window hints (option+shift+cmd+ctrl+j)
  "windowHints": {
    "hotkey": {
      "modifiers": [
        "option",
        "shift",
        "cmd",
        "ctrl"
      ],
      "key": "j"
    },
    "hint": {
      "prefixOverrides": [
        {
          "match": {
            "bundleID": "com.apple.systempreferences"
          },
          "prefix": "S"
        },
        {
          "match": {
            "bundleID": "com.apple.Preview"
          },
          "prefix": "P"
        },
        {
          "match": {
            "bundleID": "com.google.Chrome"
          },
          "prefix": "B"
        },
        {
          "match": {
            "bundleID": "com.microsoft.Word"
          },
          "prefix": "W"
        },
        {
          "match": {
            "bundleID": "com.microsoft.Excel"
          },
          "prefix": "E"
        },
        {
          "match": {
            "bundleID": "com.microsoft.Powerpoint"
          },
          "prefix": "P"
        },
      ]
    },
    "navigation": {
      "focusBack": {
        "key": "tab"
      },
      "direction": {
        "hints": {
          "keys": {
            "left": "h",
            "down": "j",
            "up": "k",
            "right": "l"
          }
        }
      },
      "areaHints": {
        "key": "space"
      },
      "applicationHints": {
        "key": "n",
        "jinraiMode": true
      },
      "windowLayouts": {
        "key": ",",
        "jinraiMode": true
      }
    }
  },
  // Window movement
  "windowMover": {
    "commands": {
      "moveToNextDisplay": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "space"
        }
      },
      "moveToActiveDisplayFreeArea": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "tab"
        }
      },
      "maximizeWindow": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "return"
        }
      },
      "cycleLeft": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "h"
        }
      },
      "cycleRight": {
        "hotkey": {
          "modifiers": [
            "option",
            "ctrl"
          ],
          "key": "l"
        }
      }
    },
    "behavior": {
      "cursor": {
        "afterMove": true
      },
      "freeArea": {
        "excludeHiddenWindows": false
      }
    },
  },
  "displayAliases": {
    "macbook": "37D8832A-2D66-02CA-B9F7-8F30A301B230",
    "desk": "A5F30F68-1D7E-41AE-97C8-2ACAE66D0AFF"
  },
  "areaHints": {
    // Default settings (used for unregistered displays)
    "defaultScreen": {
      "freeArea": "f",
      "full": "a",
      "halfLeft": "h",
      "halfRight": "l",
      "halfHorizontalCenter": "i",
      "quarterTopLeft": "u",
      "quarterTopRight": "o",
      "quarterBottomLeft": "m",
      "quarterBottomRight": ".",
      "sixthTopLeft": "6u",
      "sixthTopRight": "6o",
      "sixthBottomLeft": "6m",
      "sixthBottomRight": "6.",
      "twoThirdsLeft": "2h",
      "twoThirdsHorizontalCenter": "2i",
      "twoThirdsRight": "2l",
      "thirdLeft": "3h",
      "thirdHorizontalCenter": "3i",
      "thirdRight": "3l",
      "quarterLeft": "4h",
      "quarterRight": "4l"
    },
    // Built-in display
    "screens": {
      "macbook": {
        // With two displays, only move-and-maximize
        "2": {
          "full": "s",
        },
      },
    },
    "actions": {
      "closeWindow": "x",
      "detachChromeTabToNewWindow": "t"
    },
    "navigation": {
      "windowHints": {
        "key": "space"
      }
    },
  },
  // Jinrai mode
  "jinraiMode": {
    "triggers": {
      "windowHints": {
        "key": "m"
      }
    },
    "combo": {
      "character": {
        // Show a character image based on the action count.
        "enabled": false
      },
      "text": {
        // Show the streak count as COMBO text.
        "enabled": false
      }
    }
  },
  "profiles": [
    {
      // Enable the COMBO effect only when the desk monitor is connected.
      "displays": [
        "desk"
      ],
      "overrides": {
        "jinraiMode": {
          "combo": {
            "character": {
              "enabled": true
            },
            "text": {
              "enabled": true
            }
          }
        }
      }
    }
  ],
  // App launcher (opened with "n" from Window Hints)
  "applicationHints": {
    "apps": [
      {
        "bundleID": "com.mitchellh.ghostty",
        "key": "G"
      },
      {
        "bundleID": "com.google.Chrome",
        "key": "B"
      }
    ]
  },
  "windowLayouts": {
    "hotkey": {
      "modifiers": [
        "ctrl",
        "alt"
      ],
      "key": "m"
    },
    "layouts": [
      {
        "name": "base",
        "hotkey": {
          "modifiers": [
            "ctrl",
            "alt"
          ],
          "key": "q"
        },
        "windows": [
          {
            "bundleID": "md.obsidian",
            "screen": "desk",
            "area": "halfLeft",
            "focus": true
          },
          {
            "bundleID": "com.google.Chrome",
            "screen": "desk",
            "area": "halfRight"
          },
          {
            "bundleID": "com.mitchellh.ghostty",
            "screen": "macbook",
            "area": "full"
          }
        ],
      },
      {
        "name": "dev",
        "hotkey": {
          "modifiers": [
            "ctrl",
            "alt"
          ],
          "key": "s"
        },
        "windows": [
          {
            "bundleID": "com.mitchellh.ghostty",
            "screen": "desk",
            "area": "halfHorizontalCenter",
            "focus": true
          },
          {
            "bundleID": "md.obsidian",
            "screen": "desk",
            "area": "quarterLeft"
          },
          {
            "bundleID": "com.google.Chrome",
            "screen": "desk",
            "area": "quarterRight"
          }
        ],
      },
      {
        "name": "maximizeAll",
        "hotkey": {
          "modifiers": [
            "ctrl",
            "alt"
          ],
          "key": "a"
        },
        "unlistedWindows": {
          "area": "full"
        }
      }
    ],
  },
}
