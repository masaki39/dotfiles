{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git log*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(ls*)",
      "Bash(which*)",
      "Bash(type*)",
      "Bash(brew list*)",
      "Bash(brew info*)",
      "WebSearch"
    ],
    "deny": [
      "Read(~/.ssh/id_*)",
      "Read(~/.gnupg/**)",
      "Bash(cat ~/.ssh/id_*)",
      "Bash(security find-generic-password*)",
      "Bash(secret get*)",
      "Bash(git *--output*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"$CLAUDE_PROJECT_DIR/dashboard/status.toml\" ] && uv run --no-config --no-project --python '>=3.11' ~/.claude/skills/project-dashboard/scripts/build_dashboard.py --summary 2>/dev/null; exit 0",
            "timeout": 30,
            "statusMessage": "プロジェクトダッシュボードを読み込み中..."
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/prefer-rust-tools.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {},
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "model": "opus"
}
