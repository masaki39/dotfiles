[user]
	name = masaki39
	email = masa21gifus@gmail.com
[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
# HTTPS fetches of private repos use gh's token (after `gh auth login`); gh is found on PATH
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[ghq]
	user = masaki39
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
