[user]
	name = masaki39
	email = masa21gifus@gmail.com
[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[url "git@github.com:"]
	insteadOf = https://github.com/
[ghq]
	user = masaki39
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictStyle = zdiff3
